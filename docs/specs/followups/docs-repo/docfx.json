{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      { "files": ["**/*.{md,yml}"], "exclude": ["_site/**", "README.md", "obj/**", ".github/**", "scripts/**"] }
    ],
    "resource": [
      { "files": ["media/**", "schema/**"] }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "Xping",
      "_appTitle": "Xping",
      "_appFooter": "MIT licensed. Source: <a href=\"https://github.com/xping-dev/docs\">xping-dev/docs</a>",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": { "repo": "https://github.com/xping-dev/docs", "branch": "main" }
    },
    "sitemap": { "baseUrl": "https://docs.xping.io" }
  }
}
